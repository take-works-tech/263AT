# --- secrets / credentials ---
.env
.env.*
*.key
*.pem
credentials.json
secrets/
config.local.*

# --- data (large / licensed / 実データ) ---
# **data/ 配下は丸ごと除外する。**
# tools/security_check.py が data/ 全体をコミット禁止として扱うので、
# .gitignore 側も揃える。片方だけだと、フックが毎回ブロックして
# 「なぜコミットできないのか」を毎回調べることになる（実際にそうなった）。
data/
*.h5

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# --- node ---
node_modules/
.next/
.turbo/

# --- results / logs (keep summaries, ignore bulk) ---
results/runs/
logs/
*.log

# --- os / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- 再取得できる大きめの研究データ（tools/probe_data_sources.py で再取得） ---
research/*.parquet
research/*.zip

# --- PIT データベース（再構築可能。tools/build_pit_fundamentals.py） ---
data/pit/
forward_log/*.jsonl
research/oap_cache/
research/oq24_run.txt
research/z12_correlation.csv
research/implementation_priority.csv
research/us_cross_section.csv
